# EmailJS — https://dashboard.emailjs.com
# These are VITE_-prefixed, so they are compiled into the client bundle and are
# publicly readable by design. Restrict usage in the EmailJS dashboard under
# Account > Security > Allowed origins instead of relying on secrecy.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
